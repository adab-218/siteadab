{
  "name": "adab/gestao-templo-api",
  "description": "API de gestão do templo ADAB (Slim 4 + PDO/MySQL)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "phpmailer/phpmailer": "^6.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Adab\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Adab\\Api\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "platform": {
      "php": "8.3"
    }
  }
}
