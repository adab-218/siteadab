# API front controller (nivel /api).
# 1) Arquivo existente que nao seja index.php -> 403
#    (protege config.php, src/, vendor/, migrations/, tests/)
# 2) Qualquer outra coisa -> index.php (rotas da API)
Options -Indexes
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_FILENAME} !index\.php$
RewriteRule ^ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
