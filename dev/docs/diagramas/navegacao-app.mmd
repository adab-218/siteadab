%% Navegação e guards do frontend — revisado em 2026-10-21
%% Fonte: src/main.tsx, src/routes/RequireAuth.tsx,
%%        src/lib/auth-context.tsx, src/App.tsx
flowchart TD
    BOOT["BrowserRouter → AuthProvider:<br/>useEffect → auth.me()<br/>carregando=true → usuario|null"] --> RT["Routes"]

    RT --> HOME["/ → App (site público)"]
    HOME --> SCHED{"'Programação Semanal'?"}
    SCHED -- clique --> WS["WeeklySchedule (dialog)<br/>GET /api/public/programacao<br/>grid Seg–Dom da semana"]
    HOME --> EVS["seção #eventos<br/>GET /api/public/eventos<br/>(oculta se vazia)"]
    HOME --> FOOTER["rodapé: crédito<br/>Leon James dos Santos<br/>+ versão {VERSAO_ATUAL}"]
    FOOTER -- clique na versão --> VER

    RT --> VER["/versoes → VersoesPage<br/>(pública; lê src/lib/versoes.ts<br/>gerado do git log em prebuild)"]

    RT --> LOGIN["/login → LoginPage"]
    LOGIN --> LFORM{"modo"}
    LFORM -- login --> LPOST["auth.login(email, senha)<br/>→ guarda csrf + setUsuario"]
    LPOST -- ok --> NAV["navigate(state.from ?? '/admin')"]
    LPOST -- erro --> LERR["exibe ApiError"]
    LFORM -- 'Esqueci senha' --> REC["auth.recuperar(email)<br/>→ mensagem neutra"]

    RT --> RESET["/redefinir-senha?token= →<br/>RedefinirSenhaPage"]
    RESET --> RS["auth.redefinir(token, senha ≥10)"]
    RS -- ok --> LOGIN
    RS -- erro --> RERR["exibe erro"]

    RT --> ADMIN["/admin → RequireAuth"]
    ADMIN --> GUARD{"carregando?"}
    GUARD -- sim --> SPIN["'Carregando…'"]
    GUARD -- não --> HAS{"usuario?"}
    HAS -- null --> REDIR["Navigate → /login<br/>state.from = /admin"]
    HAS -- sim --> LAYOUT["AdminLayout<br/>sidebar (Dashboard, Membros,<br/>Cultos, Eventos, Ações, EBD)<br/>+ logout → /login"]
    LAYOUT --> IDX["index → DashboardPage"]
    LAYOUT --> MB["/admin/membros → MembrosPage<br/>(tabela + CRUD via /api/membros)"]
    LAYOUT --> DP["/admin/departamentos → DepartamentosPage<br/>(CRUD + vínculos via /api/departamentos)"]
    LAYOUT --> CU["/admin/cultos → CultosPage<br/>(agenda + tipos via /api/cultos)"]
    LAYOUT --> EV["/admin/eventos → EventosPage<br/>(eventos + atividades via /api/eventos;<br/>publico=1 → site + WeeklySchedule)"]
    LAYOUT --> AC["/admin/acoes → AcoesPage<br/>(ações + voluntários + beneficiários)"]
    LAYOUT --> US["/admin/usuarios → UsuariosPage<br/>(só admin — nav filtrado + API only-admin)"]
    LAYOUT --> MOD["/admin/:modulo → EmBrevePage<br/>(módulos em construção)"]

    RT --> FALL["* → Navigate /"]
